{
  "network": {
    "interval": 5,
    "family": "ipv4",
    "format": "{icon}",
    "format-wifi": "{icon} {signalStrength}%",
    "format-ethernet": "󰈀 Wired",
    "format-linked": "󰈀 Linked",
    "format-disconnected": "󰤭 Offline",
    "format-disabled": "󰤮 Disabled",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip": true,
    "tooltip-format": "{ifname}",
    "tooltip-format-wifi": "󰖩  Network: {essid}\n󰤨  Signal: {signalStrength}% ({signalStrengthApp})\n󰩟  IP address: {ipaddr}\n󰆍  Interface: {ifname}\n  Download: {bandwidthDownBytes}\n  Upload: {bandwidthUpBytes}",
    "tooltip-format-ethernet": "󰈀  Connection: Ethernet\n󰩟  IP address: {ipaddr}\n󰆍  Interface: {ifname}\n  Download: {bandwidthDownBytes}\n  Upload: {bandwidthUpBytes}",
    "tooltip-format-linked": "󰈀  Network link detected\n󰩟  IP address: Not assigned\n󰆍  Interface: {ifname}",
    "tooltip-format-disconnected": "󰤭  Network disconnected\n\nClick to open network settings",
    "tooltip-format-disabled": "󰤮  Wi-Fi disabled"
  }
}
