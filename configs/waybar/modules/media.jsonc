{
  "mpris": {
    "format": " {title}",
    "format-paused": " {title}",
    "tooltip-format": "{player} — {artist}\n{album}\n{position} / {length}",
    "max-length": 30,
    "on-click": "playerctl play-pause",
    "on-click-middle": "playerctl previous",
    "on-click-right": "playerctl next"
  }
}
