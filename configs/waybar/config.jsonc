{
  // Floating macOS-inspired layout. Keep the module order here; definitions live in ./modules/.
  "layer": "top",
  "position": "top",
  "height": 42,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "exclusive": true,
  "fixed-center": true,
  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left": ["custom/launcher", "niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "mpris",
    "wireplumber",
    "wireplumber#source",
    "network",
    "bluetooth",
    "niri/language",
    "idle_inhibitor",
    "tray"
  ],

  "include": [
    "modules/launcher.jsonc",
    "modules/workspaces.jsonc",
    "modules/window.jsonc",
    "modules/language.jsonc",
    "modules/clock.jsonc",
    "modules/media.jsonc",
    "modules/audio.jsonc",
    "modules/network.jsonc",
    "modules/bluetooth.jsonc",
    "modules/idle-inhibitor.jsonc",
    "modules/tray.jsonc"
    // "modules/battery.jsonc"
  ]
}
